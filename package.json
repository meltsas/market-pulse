{
  "name": "market-pulse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,ui --prefix-colors cyan,magenta \"npm:mock-server\" \"npm:dev:ui\"",
    "dev:ui": "vite --port 5551",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock-server": "node --watch mock-server/src/server.ts",
    "mock-server:record-prices": "node mock-server/scripts/record-market-data.ts",
    "mock-server:record-fundamentals": "node --env-file-if-exists=.env mock-server/scripts/record-sec-fundamentals.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@reduxjs/toolkit": "2.14.0",
    "lightweight-charts": "5.3.0",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fastify": "5.12.8",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
