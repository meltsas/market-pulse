# Fail at install time on an unsupported Node version (see "engines" in
# package.json) instead of failing later with an unrelated-looking error.
engine-strict=true

# Pin exact versions on `npm install <pkg>`.
save-exact=true

# Use the public registry even if a user-level ~/.npmrc points elsewhere, so
# package-lock.json only contains public package URLs.
registry=https://registry.npmjs.org/
